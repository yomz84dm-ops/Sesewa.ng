# ------------------------------------------------------------------------------
# API KEYS & SECRETS
# ------------------------------------------------------------------------------

# Gemini AI API Key (Get from: https://aistudio.google.com/app/apikey)
# Essential for HandyPadi chat and smart features
GEMINI_API_KEY=

# Aella Secret Key (Get from: https://aellaapp.com)
# Essential for processing payments securely on the server
AELLA_SECRET_KEY=

# Aella Public Key
# Essential for initializing the Aella checkout in the browser
VITE_AELLA_PUBLIC_KEY=

# ------------------------------------------------------------------------------
# FIREBASE CONFIGURATION (Vite Client-side)
# ------------------------------------------------------------------------------
# These are used as fallbacks if firebase-applet-config.json is missing.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIRESTORE_DATABASE_ID=

# ------------------------------------------------------------------------------
# DEPLOYMENT NOTES (handypadi.ng / Firebase Hosting)
# ------------------------------------------------------------------------------
# 1. Add your custom domains (handypadi.ng, etc.) to the "Authorized Domains" 
#    list in the Firebase Console under Auth -> Settings.
# 2. Set GEMINI_API_KEY and AELLA_SECRET_KEY in your Firebase Functions 
#    environment using:
#    firebase functions:secrets:set GEMINI_API_KEY
#    firebase functions:secrets:set AELLA_SECRET_KEY
# ------------------------------------------------------------------------------
